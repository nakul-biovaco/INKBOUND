# ==============================================================================
# INKBOUND — Game Engine Server Environment Variables
# Copy this file to 'server/.env' and configure your settings.
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret for Player Session Tokens
JWT_SECRET=inkbound_dev_secret_change_me_in_production_2026

# Redis URL (Optional)
# If omitted or empty, the server automatically uses the high-performance in-memory store
REDIS_URL=

# CORS Allowed Origin
# Set to '*' for all origins or specific domain (e.g. https://inkbound.vercel.app)
CORS_ORIGIN=*

# Self / Backend Public URL (Used for health checks and keep-alive pingers)
SERVER_URL=http://localhost:3001
