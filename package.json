{
  "name": "inkbound",
  "version": "1.0.0",
  "description": "Multiplayer Real-Time Detective Deduction & Live Drawing Party Game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "multiplayer",
    "party-game",
    "detective",
    "deduction",
    "realtime",
    "drawing",
    "canvas",
    "websocket",
    "react",
    "fastify"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "ws": "^8.21.3"
  }
}
