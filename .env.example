# ==============================================================================
# INKBOUND — Client Environment Variables
# Copy this file to '.env' and fill in your configuration.
# ==============================================================================

# Supabase Project Configuration
# Found in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Realtime Game Server (Fastify + WebSocket)
# For local development: http://localhost:3001 and ws://localhost:3001/ws
# For production: e.g. https://your-backend.onrender.com and wss://your-backend.onrender.com/ws
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
